# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database — port 5544 (5432/5433 sont pris par des PostgreSQL natifs Windows)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5544/kandi_db"



# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# CORS - origines navigateur autorisees (separees par des virgules)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Encryption (SMTP passwords)
ENCRYPTION_KEY=your-32-char-aes-256-key-is-here

# OpenAI
OPENAI_API_KEY=sk-test

# Stripe
STRIPE_SECRET_KEY=sk_test_123
STRIPE_WEBHOOK_SECRET=whsec_123

# Email sending (transactionnel - notifications app)
RESEND_API_KEY=re_123

# Storage (CVs)
R2_ACCOUNT_ID=test
R2_ACCESS_KEY=test
R2_SECRET_KEY=test
R2_BUCKET_NAME=kandi-cvs

# Company data APIs
HUNTER_API_KEY=test
