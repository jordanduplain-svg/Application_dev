# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kandi_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# CORS - origines navigateur autorisees (separees par des virgules)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Encryption (SMTP passwords)
ENCRYPTION_KEY=your-32-char-aes-256-key

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email sending (transactionnel - reinitialisation mot de passe, etc.)
# Optionnel : sans cle, le mailer journalise l'email au lieu de l'envoyer (dev).
RESEND_API_KEY=re_...
MAIL_FROM=Candio <noreply@candio.app>

# Storage (CVs)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET_NAME=kandi-cvs

# Company data APIs
HUNTER_API_KEY=...      # Trouver les emails de contact
