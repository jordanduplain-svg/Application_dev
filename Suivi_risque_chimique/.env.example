# ============================================================
# Suivi du risque chimique — variables d'environnement
# ============================================================
# Copier ce fichier en `.env` à la racine puis adapter.
# NE JAMAIS committer le fichier `.env` (voir .gitignore).
# ============================================================

# --- Base de données (Docker compose, dev) ---
POSTGRES_USER=cmr
POSTGRES_PASSWORD=cmr_dev_password
POSTGRES_DB=cmr_tracker
POSTGRES_PORT=5432
ADMINER_PORT=8080

# URL de connexion utilisée par Prisma (backend).
# Format Prisma : postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://cmr:cmr_dev_password@localhost:5432/cmr_tracker?schema=public

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=3001
# Mode « tout-en-un » : si true, l'application démarre elle-même un PostgreSQL
# embarqué (binaire natif, sans Docker ni installation) et applique les
# migrations avant de servir — une seule commande lance tout (cf. `start:embedded`,
# `dev:embedded`, ou l'option CLI `--embedded`). Laisser vide/false pour pointer
# vers un PostgreSQL externe (ou une base lancée à part via `pnpm db:embedded`).
DB_EMBEDDED=false
# Origine autorisée pour CORS (frontend Vite par défaut).
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth ---
# Provider d'authentification : "local" (MVP) | "oidc" (post-MVP)
#   - local : email/password gérés par l'app, zéro dépendance externe
#   - oidc  : délégué à un fournisseur OpenID Connect que VOUS choisissez et hébergez
#            (Keycloak, Authentik, Zitadel, Dex…). Techniquement compatible avec n'importe
#            quel OIDC standard, mais ce projet privilégie les fournisseurs open source
#            self-hostables — cohérent avec la promesse "vos données ne quittent jamais
#            votre infra".
AUTH_PROVIDER=local

# Secret JWT pour le provider local (générer avec : openssl rand -base64 48)
# OBLIGATOIRE en production. Tout déploiement avec la valeur d'exemple ci-dessous doit échouer.
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Auth OIDC générique (post-MVP, ignoré si AUTH_PROVIDER=local) ---
# Exemple typique : Keycloak self-hosted.
#   OIDC_ISSUER_URL=https://keycloak.votre-domaine.fr/realms/cmr
# L'app récupère automatiquement les endpoints via le document de découverte
# (/.well-known/openid-configuration) — aucun couplage à un fournisseur particulier.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# --- Chiffrement au repos ---
# Le chiffrement au repos des données de santé est DÉLÉGUÉ AU DÉPLOIEMENT :
# volume disque chiffré (LUKS…) et/ou Postgres TDE — standard en self-hosted.
# La variable ci-dessous est OPTIONNELLE et non utilisée par l'app au MVP ;
# elle est réservée à un futur chiffrement applicatif des champs. Laissez-la
# vide (ou supprimez-la). Si vous la renseignez, n'utilisez PAS la valeur
# d'exemple : clé 32 octets base64 (openssl rand -base64 32).
FIELD_ENCRYPTION_KEY=

# --- Anonymisation ---
# Seuil k-anonymat appliqué aux exports CSE / vues anonymisées.
K_ANONYMITY_THRESHOLD=5

# --- Conservation des données (en années) ---
# Défaut 40 ans (art. R. 4412-93-3). 0 = aucune purge automatique.
DATA_RETENTION_YEARS=40

# --- Frontend (Vite, préfixe obligatoire VITE_) ---
VITE_API_BASE_URL=http://localhost:3001
VITE_DEFAULT_LOCALE=fr
