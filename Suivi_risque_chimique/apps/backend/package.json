{
  "name": "@cmr-tracker/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "dev:embedded": "tsx --env-file=../../.env src/main.ts --embedded",
    "start:embedded": "node dist/main.js --embedded",
    "db:embedded": "tsx --env-file=../../.env scripts/db-embedded.ts",
    "seed:demo": "tsx test/seed-demo.ts",
    "seed:demo:large": "tsx test/generate-demo-dataset.ts && tsx test/seed-demo.ts demo-large.xlsx",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "embedded-postgres": "18.4.0-beta.17",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.3",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "snowflake-sdk": "^3.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/snowflake-sdk": "^1.6.24",
    "eslint": "^9.12.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
