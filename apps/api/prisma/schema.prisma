// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // L'URL provient de la variable d'environnement DATABASE_URL (validée par
  // config/env.ts). Ne JAMAIS coder l'URL en dur : le déploiement (Docker,
  // prod) utilise un hôte différent de localhost.
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  emailSender      String?   // Email depuis lequel envoyer les candidatures
  smtpConfig       Json?     // Config SMTP chiffrée (AES-256)
  cvUrl            String?   // URL S3/Cloudflare R2 du CV
  cvParsed         Json?     // CV parsé par l'IA (expériences, compétences…)
  stripeCustomerId String?   @unique
  pushToken        String?
  plan             Plan      @default(FREE)
  // Consentement RGPD : date d'acceptation des CGU + version acceptée.
  // `null` = aucune acceptation enregistrée (comptes créés avant la mise en place).
  tosAcceptedAt    DateTime?
  tosVersion       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaigns           Campaign[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invoices            Invoice[]
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

model Campaign {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  name             String
  prompt           String          // Description libre de la recherche
  jobTitle         String
  location         String
  contractTypes    String[]        // ["CDI", "CDD", "Remote"]
  salaryMin        Int?
  salaryMax        Int?
  budget           Decimal
  applicationQuota Int          // Nombre de candidatures achetées
  status           CampaignStatus  @default(PENDING)
  stripePaymentId  String?
  startedAt        DateTime?
  completedAt      DateTime?
  // Remboursement (A3) : renseignés lorsqu'une campagne échouée ou
  // partiellement livrée donne lieu à un avoir.
  refundedAt       DateTime?
  refundAmount     Decimal?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  applications     Application[]
  invoices         Invoice[]

  // Toutes les requêtes de campagnes filtrent par `userId` (liste, dashboard,
  // stats) : sans cet index, chaque accès déclenche un scan séquentiel.
  @@index([userId])
}

enum CampaignStatus {
  PENDING      // En attente de paiement
  PAID         // Payée, en attente de lancement
  RUNNING      // En cours
  PAUSED
  COMPLETED
  FAILED
}

model Application {
  id              String              @id @default(cuid())
  campaignId      String
  // onDelete: Cascade → supprimer une campagne supprime ses candidatures
  // (sinon la suppression échoue par violation de clé étrangère).
  campaign        Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companyName     String
  companyWebsite  String?
  contactEmail    String
  contactName     String?
  contactRole     String?
  subject         String              // Objet de l'email généré
  body            String              // Corps de l'email généré
  status          ApplicationStatus   @default(PENDING)
  sentAt          DateTime?
  openedAt        DateTime?           // Tracking pixel (optionnel)
  repliedAt       DateTime?
  replyContent    String?
  errorMessage    String?             // Si l'envoi échoue
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([campaignId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  SENDING
  SENT
  OPENED
  REPLIED
  BOUNCED
  FAILED
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  // Le nettoyage opportuniste filtre sur `expiresAt` : sans index, chaque
  // authentification déclenche un scan séquentiel.
  @@index([expiresAt])
}

// Jeton de réinitialisation de mot de passe (S1).
// On ne stocke que le hash SHA-256 du code envoyé par email — jamais le code
// en clair. `usedAt` rend le jeton à usage unique.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // Nombre d'essais de code erronés : au-delà d'un seuil, le jeton est
  // verrouillé (protection anti-bruteforce du code à 6 chiffres).
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Facture / avoir (A2 + A3).
// `CHARGE` : achat d'une campagne. `REFUND` : avoir lié à un remboursement.
model Invoice {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  number      String        @unique // Numéro lisible : KJ-2026-000123
  type        InvoiceType   @default(CHARGE)
  amount      Decimal // Montant en euros (positif ; le `type` indique le sens)
  currency    String        @default("EUR")
  description String
  status      InvoiceStatus @default(PAID)
  issuedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([userId])
}

enum InvoiceType {
  CHARGE
  REFUND
}

enum InvoiceStatus {
  PAID
  REFUNDED
}
